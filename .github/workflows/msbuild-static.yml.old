name: MSBuild

on: [workflow_dispatch]

# on:
#   push:
#     branches: 
#      - 'master'

env:
  # Path to the solution file relative to the root of the project.
  SOLUTION_FILE_PATH: .

  # Configuration type to build.
  # You can convert this to a build matrix if you need coverage of multiple configuration types.
  # https://docs.github.com/actions/learn-github-actions/managing-complex-workflows#using-a-build-matrix
  BUILD_CONFIGURATION: Release
  
  OUT_DIR: dist
  GITLAB_TOKEN: ${{ secrets.GITLAB_TOKEN }}
  FEANOR_CORE_ID: 11660029
  FEANOR_EXTERNAL_ID: 13987704
  
jobs:
  build-feanor-core:
    runs-on: windows-2022
    outputs:
      sha: ${{ steps.core-sha.outputs.sha }}
    steps:
    - name: Get Feanor Core SHA JSON
      run: |
        curl --location --output feanor.core.sha --header "PRIVATE-TOKEN: ${{env.GITLAB_TOKEN}}" "https://gitlab.com/api/v4/projects/${{env.FEANOR_CORE_ID}}/repository/commits/master"
    
    - name: Read Feanor Core Commit SHA JSON to Variable
      id: read-core-sha
      uses: juliangruber/read-file-action@v1.1.6
      with:
        path: feanor.core.sha
    
    - name: Set output Feanor Core SHA
      id: core-sha
      run: echo "sha=${{ fromJson(steps.read-core-sha.outputs.content).id }}" | Out-File -FilePath $Env:GITHUB_OUTPUT -Encoding utf-8 -Append
        
    - name: Cache Feanor Core
      id: cache-core
      uses: actions/cache@v3.2.2
      with:
        path: installed-core
        key: feanor-core-${{ steps.core-sha.outputs.sha }}
    
    - name: Get Feanor Core Repo
      if: steps.cache-core.outputs.cache-hit != 'true'
      run: |
        git clone https://oauth2:${{env.GITLAB_TOKEN}}@gitlab.com/cgvg/feanor/core feanor-core
        cd feanor-core
        git checkout ${{ steps.core-sha.outputs.sha }}
        cd ..
    
    - name: Build and install Feanor Core
      if: steps.cache-core.outputs.cache-hit != 'true'
      run: |
        cmake -S feanor-core -B feanor-core/build -DCMAKE_INSTALL_PREFIX:PATH="${{github.workspace}}\installed-core" -DBUILD_SHARED_LIBS:BOOL=OFF
        cmake --build feanor-core/build --config Release --parallel --target install
        
  build-feanor-external:
    runs-on: windows-2022
    outputs:
      sha: ${{ steps.external-sha.outputs.sha }}
    steps:
    - name: Get Feanor External Commit SHA
      run: |
        curl --location --output feanor.external.sha --header "PRIVATE-TOKEN: ${{env.GITLAB_TOKEN}}" "https://gitlab.com/api/v4/projects/${{env.FEANOR_EXTERNAL_ID}}/repository/commits/master"

    - name: Read Feanor External Commit SHA to Variable
      id: read-external-sha
      uses: juliangruber/read-file-action@v1.1.6
      with:
        path: feanor.external.sha
        
    - name: Set output Feanor External SHA
      id: external-sha
      run: echo "sha=${{ fromJson(steps.read-external-sha.outputs.content).id }}" | Out-File -FilePath $Env:GITHUB_OUTPUT -Encoding utf-8 -Append
      
    - name: Cache Feanor External
      id: cache-external
      uses: actions/cache@v3.2.2
      with:
        path: installed-external
        key: feanor-external-${{ steps.external-sha.outputs.sha }}
        
    - name: Get Feanor External Repo
      if: steps.cache-external.outputs.cache-hit != 'true'
      run: |
        git clone https://oauth2:${{env.GITLAB_TOKEN}}@gitlab.com/cgvg/feanor/external feanor-external
        cd feanor-external
        git checkout ${{ steps.external-sha.outputs.sha }}
        git submodule update --init --recursive
        cd ..
        
    - name: Build and install Feanor External
      if: steps.cache-external.outputs.cache-hit != 'true'
      working-directory: ${{github.workspace}}\feanor-external
      run: |
        .\install.ps1 "${{github.workspace}}\installed-external" OFF
        
  build-nvidia-nri:
    runs-on: windows-2022
    outputs:
      sha: ${{ steps.nri-sha.outputs.sha }}
    steps:
    - name: Get NVIDIA NRI details
      run: |
        curl --location --output nri.sha "https://api.github.com/repos/NVIDIAGameWorks/NRI/commits/main"
    
    - name: Read NVIDIA NRI Json from file
      id: read-nri-json
      uses: juliangruber/read-file-action@v1.1.6
      with:
        path: nri.sha
        
    - name: Set output NVIDIA NRI SHA
      id: nri-sha
      run: echo "sha=${{ fromJson(steps.read-nri-json.outputs.content).sha }}" | Out-File -FilePath $Env:GITHUB_OUTPUT -Encoding utf-8 -Append
    
    - name: Cache NVIDIA NRI
      id: cache-nri
      uses: actions/cache@v3.2.2
      with:
        path: NRI\_NRI_SDK
        key: nvidia-nri-${{ steps.nri-sha.outputs.sha }}
    
    # Static lib is broken - Add "-DNRI_STATIC_LIBRARY:BOOL=ON" to try again
    - name: Get NVIDIA NRI
      if: steps.cache-nri.outputs.cache-hit != 'true'
      run: |
        git clone https://github.com/NVIDIAGameWorks/NRI
        cd NRI
        git checkout ${{ steps.nri-sha.outputs.sha }}
        git submodule update --init --recursive
        cmake -B _Compiler
        cmake --build _Compiler --parallel --config Release
        & ".\3-Prepare NRI SDK.bat"
        cd ..
        
  build-nvidia-nrd:
    runs-on: windows-2022
    outputs:
      sha: ${{ steps.nrd-sha.outputs.sha }}
    steps:
    - name: Get NVIDIA NRD details
      run: |
        curl --location --output nrd.sha "https://api.github.com/repos/NVIDIAGameWorks/RayTracingDenoiser/commits/master"

    - name: Read NVIDIA NRD Json from file
      id: read-nrd-json
      uses: juliangruber/read-file-action@v1.1.6
      with:
        path: nrd.sha

    - name: Set output NVIDIA NRD SHA
      id: nrd-sha
      run: echo "sha=${{ fromJson(steps.read-nrd-json.outputs.content).sha }}" | Out-File -FilePath $Env:GITHUB_OUTPUT -Encoding utf-8 -Append
    
    - name: Cache NVIDIA NRD
      id: cache-nrd
      uses: actions/cache@v3.2.2
      with:
        path: RayTracingDenoiser\_NRD_SDK
        key: nvidia-nrd-${{ steps.nrd-sha.outputs.sha }}

    - name: Get Microsoft DXC Json
      if: steps.cache-nrd.outputs.cache-hit != 'true'
      run: curl --location --output microsoft.dxc "https://api.github.com/repos/microsoft/DirectXShaderCompiler/releases/latest"

    - name: Read Microsoft DXC Json from file
      if: steps.cache-nrd.outputs.cache-hit != 'true'
      id: read-dxc-json
      uses: juliangruber/read-file-action@v1.1.6
      with:
        path: microsoft.dxc

    - name: Get Microsoft DXC Zip Asset
      if: steps.cache-nrd.outputs.cache-hit != 'true'
      run: curl --location --output msdxc.zip "${{ fromJson(steps.read-dxc-json.outputs.content).assets[0].browser_download_url }}"

    - name: Extract Microsoft DXC Zip Asset
      if: steps.cache-nrd.outputs.cache-hit != 'true'
      run: 7z x msdxc.zip -odxc

    # For static add -DNRD_STATIC_LIBRARY:BOOL=ON 
    - name: Get NVIDIA NRD
      if: steps.cache-nrd.outputs.cache-hit != 'true'
      run: |
        git clone https://github.com/NVIDIAGameWorks/RayTracingDenoiser
        cd RayTracingDenoiser
        git checkout ${{ steps.nrd-sha.outputs.sha }}
        git submodule update --init --recursive
        cmake -B _Compiler -DNRD_INTERPROCEDURAL_OPTIMIZATION:BOOL=ON -DDXC_SPIRV_PATH:FILEPATH="${{github.workspace}}\dxc\bin\x64\dxc.exe"
        cmake --build _Compiler --parallel --config Release
        & ".\3-Prepare NRD SDK.bat" --no-pause --no-shaders --integration
        cd ..
  
  build:
    runs-on: windows-2022
    needs: [build-feanor-core, build-feanor-external, build-nvidia-nri, build-nvidia-nrd]
    steps:
    - uses: actions/checkout@v3.3.0
    
    # Get cache contents
    - name: Cache Feanor Core
      id: cache-core
      uses: actions/cache@v3.2.2
      with:
        path: installed-core
        key: feanor-core-${{ needs.build-feanor-core.outputs.sha }}

    - name: Cache Feanor External
      id: cache-external
      uses: actions/cache@v3.2.2
      with:
        path: installed-external
        key: feanor-external-${{ needs.build-feanor-external.outputs.sha }}

    - name: Cache NVIDIA NRI
      id: cache-nri
      uses: actions/cache@v3.2.2
      with:
        path: NRI\_NRI_SDK
        key: nvidia-nri-${{ needs.build-nvidia-nri.outputs.sha }}

    - name: Cache NVIDIA NRD
      id: cache-nrd
      uses: actions/cache@v3.2.2
      with:
        path: RayTracingDenoiser\_NRD_SDK
        key: nvidia-nrd-${{ needs.build-nvidia-nrd.outputs.sha }}
    
    # Validate all caches present
    - name: Validate all caches present
      if: steps.cache-core.outputs.cache-hit != 'true' || steps.cache-external.outputs.cache-hit != 'true' || steps.cache-nri.outputs.cache-hit != 'true' || steps.cache-nrd.outputs.cache-hit != 'true'
      run: |
        echo "Validation failed. There is a missing cache"
        exit 1
    
    # Merge dirs
    - name: Merge dependency directories into installed directory
      run: |
        New-Item installed -ItemType Directory
        Copy-Item -Path installed-core\* -Destination installed -Recurse -Force
        Copy-Item -Path installed-external\* -Destination installed -Recurse -Force
    
    - name: Add FEANOR_ROOT Environment Variable
      run: echo "FEANOR_ROOT=${{github.workspace}}\installed" | Out-File -FilePath $Env:GITHUB_ENV -Encoding utf-8 -Append

    - name: Add NRI_ROOT Environment Variable
      run: echo "NRI_ROOT=${{github.workspace}}\NRI\_NRI_SDK" | Out-File -FilePath $Env:GITHUB_ENV -Encoding utf-8 -Append

    - name: Add NRD_ROOT Environment Variable
      run: echo "NRD_ROOT=${{github.workspace}}\RayTracingDenoiser\_NRD_SDK" | Out-File -FilePath $Env:GITHUB_ENV -Encoding utf-8 -Append
      
    - name: Add MSBuild to PATH
      uses: microsoft/setup-msbuild@v1.1.3

    - name: Build
      working-directory: ${{github.workspace}}
      # Add additional options to the MSBuild command line here (like platform or verbosity level).
      # See https://docs.microsoft.com/visualstudio/msbuild/msbuild-command-line-reference
      run: msbuild /m /p:Configuration=${{env.BUILD_CONFIGURATION}} /p:ForceImportBeforeCppTargets=${{github.workspace}}\MyProps.props /p:OutDir=${{github.workspace}}\${{env.OUT_DIR}}\ ${{env.SOLUTION_FILE_PATH}}
      
    - name: Copy NRI and NRD DLL
      run: |
        Copy-Item ".\NRI\_NRI_SDK\Lib\Release\NRI.dll" -Destination "${{github.workspace}}\${{env.OUT_DIR}}\"
        Copy-Item ".\RayTracingDenoiser\_NRD_SDK\Lib\Release\NRD.dll" -Destination "${{github.workspace}}\${{env.OUT_DIR}}\"

    - uses: actions/upload-artifact@v3.1.1
      with:
        name: CandelaDXR
        path: ${{github.workspace}}\${{env.OUT_DIR}}\
        retention-days: 14
